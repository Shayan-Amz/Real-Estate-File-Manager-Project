# =====================================================================
#  املاک من — پیکربندی Apache
# ---------------------------------------------------------------------
#  ⚠️ این فایل جایگزین دو فایل قبلی شد:
#     ۱) `.htaccess` قدیمی که فقط Basic Auth داشت و هیچ محافظتی از
#        config.php / backups / uploads نمی‌کرد.
#     ۲) `htaccess` (بدون نقطه) که اصلاً فعال نبود، syntax آپاچی ۲.۲ داشت
#        و در اولین بلوک، api.php را هم Deny می‌کرد (یعنی اگر روزی نامش
#        درست می‌شد کل API از کار می‌افتاد). آن فایل حذف شد.
#
#  نکته: Basic Auth عمداً نگه داشته شده چون این زیردامنهٔ تست است.
#        برای دامنهٔ اصلی، بلوک «قفل ورود» را حذف یا کامنت کن.
# =====================================================================

# ۱) جلوگیری از نمایش فهرست فایل‌ها
Options -Indexes

# ---------------------------------------------------------------------
# ۲) محافظت از فایل‌های حساس
# ---------------------------------------------------------------------
# آپاچی ۲.۴
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Require all denied
    </FilesMatch>
</IfModule>
# آپاچی ۲.۲ (پشتیبان)
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# api.php باید در دسترس بماند — صریحاً آزاد می‌شود تا بلوک‌های بالایی
# (یا هر قاعدهٔ ارثی) آن را نبندند.
<IfModule mod_authz_core.c>
    <Files "api.php">
        Require all granted
    </Files>
</IfModule>

# ---------------------------------------------------------------------
# ۳) پوشه‌هایی که هرگز نباید مستقیماً خوانده شوند
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(backups|tools|cgi-bin)(/|$) - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# ۴) جلوگیری از اجرای بدافزار آپلودشده در پوشهٔ عکس‌ها
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php5|php7|phps|phar|pl|py|cgi|sh|js)$ - [F,L,NC]
</IfModule>

# ---------------------------------------------------------------------
# ۵) فشرده‌سازی و کش مرورگر
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 year"
    ExpiresByType image/png   "access plus 1 year"
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2  "access plus 1 year"
    ExpiresByType text/css    "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# ---------------------------------------------------------------------
# ۶) هدرهای امنیتی
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------
# ۷) قفل ورود (Basic Auth) — فقط برای زیردامنهٔ تست
# ---------------------------------------------------------------------
# ⚠️ عمداً فعال نگه داشته شد تا سطح دسترسی فعلی سایت تغییر نکند.
# ⚠️ مسیر AuthUserFile باید واقعاً روی سرور وجود داشته باشد، وگرنه آپاچی
#    به‌جای ۴۰۱ خطای ۵۰۰ برمی‌گرداند. مسیر دقیقاً از فایل قبلی نگه داشته شده:
#    /home/owihpfoa/domains/test.amlak-e-man.ir/.htpasswd/public_html/.htpasswd
#    (به‌نظر می‌رسد یک «.htpasswd/» اضافی به‌عنوان پوشه در مسیر هست — روی
#     هاست چک شود که این فایل واقعاً وجود دارد.)
# ⚠️ برای دامنهٔ اصلی، همین چهار خط را کامنت کن.
AuthName "Super Admin"
AuthType Basic
AuthUserFile /home/owihpfoa/domains/test.amlak-e-man.ir/.htpasswd/public_html/.htpasswd
Require valid-user
ErrorDocument 401 "Unauthorized Access"
