# =====================================================================
#  املاک من — پیکربندی Apache (نسخهٔ بازیابی)
# ---------------------------------------------------------------------
#  🔴 تغییر مهم: بلوک «قفل ورود (Basic Auth)» عمداً حذف شد، چون مسیر
#     AuthUserFile (…/.htpasswd/public_html/.htpasswd) روی هاست مشکوک بود
#     و اگر فایل وجود نداشته باشد، آپاچی برای «کل سایت» 500 می‌دهد.
#     این دقیقاً همان حالتی است که «سایت کلا کار نمی‌کند».
#
#     برای برگرداندن ورود با نام کاربری/رمز، بعد از اینکه سایت بالا آمد،
#     انتهای همین فایل را طبق «بخش ۷» پایین باز کنید.
#
#  محافظت‌های مهم (config/backups/uploads/tools) فعال هستند.
# =====================================================================

# ۱) جلوگیری از نمایش فهرست فایل‌ها
Options -Indexes

# ---------------------------------------------------------------------
# ۲) محافظت از فایل‌های حساس
# ---------------------------------------------------------------------
# آپاچی ۲.۴
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Require all denied
    </FilesMatch>
</IfModule>
# آپاچی ۲.۲ (پشتیبان)
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# api.php باید در دسترس بماند — صریحاً آزاد می‌شود
<IfModule mod_authz_core.c>
    <Files "api.php">
        Require all granted
    </Files>
</IfModule>

# ---------------------------------------------------------------------
# ۳) پوشه‌هایی که هرگز نباید مستقیماً خوانده شوند
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # استثناء: فقط فایل بررسی سلامت (کلید HEALTH_KEY داخل خود فایل است)
    RewriteRule ^tools/health_check\.php$ - [L]
    # هر چیز دیگری در backups / tools / cgi-bin → 403
    RewriteRule ^(backups|tools|cgi-bin)(/|$) - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# ۴) جلوگیری از اجرای بدافزار آپلودشده در پوشهٔ عکس‌ها
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php5|php7|phps|phar|pl|py|cgi|sh|js)$ - [F,L,NC]
</IfModule>

# ---------------------------------------------------------------------
# ۵) فشرده‌سازی و کش مرورگر
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 year"
    ExpiresByType image/png   "access plus 1 year"
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2  "access plus 1 year"
    ExpiresByType text/css    "access plus 1 month"
    # ⚡ JS را طولانی کش نمی‌کنیم تا sw.js همیشه به‌روز برسد
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresDefault "access plus 2 days"
</IfModule>

# 🔴 sw.js هرگز کش نشود — این‌کلید رفع «سرویس‌ورکر قدیمی» است
<IfModule mod_headers.c>
    <Files "sw.js">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>
</IfModule>

# ---------------------------------------------------------------------
# ۶) هدرهای امنیتی
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # فایل‌های PHP هرگز کش نشوند
    <FilesMatch "\.(php|phtml)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# ۷) قفل ورود (Basic Auth) — اختیاری؛ برای زیردامنهٔ تست
# ---------------------------------------------------------------------
# ⚠️ این بخش فعلاً غیرفعال است (علت: سایت با آن 500 می‌داد).
#    برای فعال‌کردن بعد از بالا آمدن سایت، خطوط زیر را از حالت کامنت خارج کن
#    و مسیر AuthUserFile را با مسیر واقعی فایل .htpasswd روی هاستت جایگزین کن.
#
# AuthName "Super Admin"
# AuthType Basic
# AuthUserFile /home/owihpfoa/domains/test.amlak-e-man.ir/.htpasswd/public_html/.htpasswd
# Require valid-user
# ErrorDocument 401 "Unauthorized Access"
