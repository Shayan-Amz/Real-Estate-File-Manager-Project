# 1. غیرفعال کردن نمایش لیست فایل‌های پوشه‌ها (Directory Listing)
Options -Indexes

# 2. محافظت شدید از فایل‌های حساس (مخفی کردن کانفیگ از دید عموم)
<FilesMatch "^(config\.php|api\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# البته api.php باید در دسترس باشد، پس خط بالا را اصلاح می‌کنیم:
<FilesMatch "^(config\.php|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. جلوگیری از اجرای بدافزارهای آپلود شده در پوشه عکس‌ها
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|php5|pl|py|jsp|asp|sh|cgi|js)$ - [F,L,NC]
</IfModule>

# 4. فعال‌سازی فشرده‌سازی GZIP برای افزایش 300 درصدی سرعت سایت
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. کش کردن عکس‌ها در مرورگر کاربر (برای لود آنی در دفعات بعدی)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
    # ⚡ فشرده‌سازی تمام فایل‌های متنی برای لود فوق‌سریع
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>

<IfModule mod_expires.c>
    # ⚡ کش کردن استایل‌ها، فونت‌ها و عکس‌ها در مرورگر
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# جلوگیری از دیده شدن لیست فایل‌های public_html توسط هکرها
Options -Indexes