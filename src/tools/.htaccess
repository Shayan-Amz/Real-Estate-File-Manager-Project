# ⚡ ابزارهای تشخیصی: از وب بسته باشند
# استثناء فقط برای health_check.php که خودش با کلید HEALTH_KEY محافظت می‌شود
# و فقط می‌خواند (چیزی نمی‌نویسد و رازی چاپ نمی‌کند).
#
# ⚠️ این استثناء فقط وقتی کار می‌کند که `.htaccess` ریشهٔ پروژه هم
#    `tools/health_check.php` را مستثنا کرده باشد (نسخهٔ فعلی بله).
#    در غیر این صورت قاعدهٔ RewriteRule ریشه، درخواست را قبل از رسیدن
#    به این فایل با 403 رد می‌کند. ترتیب «اول Deny بعد Grant» مهم است:
#    در آپاچی ۲.۴، بخش بعدی روی بخش قبلی override می‌شود.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar)$">
        Require all denied
    </FilesMatch>
    <Files "health_check.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "health_check.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>
