# =====================================================================
#  املاک من — پیکربندی Apache
# ---------------------------------------------------------------------
#  ⚠️ این فایل جایگزین دو فایل قبلی شد:
#     ۱) `.htaccess` قدیمی که فقط Basic Auth داشت و هیچ محافظتی از
#        config.php / backups / uploads نمی‌کرد.
#     ۲) `htaccess` (بدون نقطه) که اصلاً فعال نبود، syntax آپاچی ۲.۲ داشت
#        و در اولین بلوک، api.php را هم Deny می‌کرد (یعنی اگر روزی نامش
#        درست می‌شد کل API از کار می‌افتاد). آن فایل حذف شد.
#
#  نکته: Basic Auth عمداً نگه داشته شده چون این زیردامنهٔ تست است.
#        برای دامنهٔ اصلی، بلوک «قفل ورود» را حذف یا کامنت کن.
# =====================================================================

# ۱) جلوگیری از نمایش فهرست فایل‌ها
Options -Indexes

# ---------------------------------------------------------------------
# ۲) محافظت از فایل‌های حساس
# ---------------------------------------------------------------------
# آپاچی ۲.۴
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Require all denied
    </FilesMatch>
</IfModule>
# آپاچی ۲.۲ (پشتیبان)
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|config\.example\.php|stt\.php|\.htaccess|\.htpasswd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# api.php باید در دسترس بماند — صریحاً آزاد می‌شود تا بلوک‌های بالایی
# (یا هر قاعدهٔ ارثی) آن را نبندند.
<IfModule mod_authz_core.c>
    <Files "api.php">
        Require all granted
    </Files>
</IfModule>

# ---------------------------------------------------------------------
# ۳) پوشه‌هایی که هرگز نباید مستقیماً خوانده شوند
# ---------------------------------------------------------------------
# ⚠️ اصلاح مهم: قبلاً tools/ هم با همین قاعده یکجا بسته می‌شد، یعنی درخواست
#    /tools/health_check.php قبل از رسیدن به PHP و قبل از اینکه tools/.htaccess
#    فرصت «استثناء» داشته باشد، همین‌جا با 403 رد می‌شد. استثناءِ
#    «Require all granted» داخل tools/.htaccess عملاً هرگز اجرا نمی‌شد.
#    حالا فقط health_check.php را از قاعده مستثنا می‌کنیم؛ بقیهٔ محتوای
#    backups / tools / cgi-bin همچنان از وب کاملاً بسته است.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # استثناء: فقط فایل بررسی سلامت (کلید HEALTH_KEY داخل خود فایل است)
    RewriteRule ^tools/health_check\.php$ - [L]
    # هر چیز دیگری در backups / tools / cgi-bin → 403
    RewriteRule ^(backups|tools|cgi-bin)(/|$) - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# ۴) جلوگیری از اجرای بدافزار آپلودشده در پوشهٔ عکس‌ها
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php5|php7|phps|phar|pl|py|cgi|sh|js)$ - [F,L,NC]
</IfModule>

# ---------------------------------------------------------------------
# ۵) فشرده‌سازی و کش مرورگر
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 year"
    ExpiresByType image/png   "access plus 1 year"
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2  "access plus 1 year"
    ExpiresByType text/css    "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# ---------------------------------------------------------------------
# ۶) هدرهای امنیتی
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------
# نسخهٔ دفاع: هیچ مسیر یا رمز خصوصیِ هاست در این بسته نیست.
# حفاظت ورودی محیط آزمایش باید توسط مدیر هاست پیکربندی شود.
