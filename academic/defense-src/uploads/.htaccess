# ⚡ پوشهٔ آپلود: فقط فایل داده، هیچ اسکریپتی اجرا نشود
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php5|php7|phps|phar|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php5|php7|phps|phar|pl|py|cgi|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler  .php .phtml .php5 .php7 .phps .phar
    RemoveType     .php .phtml .php5 .php7 .phps .phar
    SetHandler     none
</IfModule>
